# Leash Gateway & Server
PORT=4000
NODE_ENV=development
# Leave DATABASE_URL unset to run on in-memory stores locally. The Postgres path creates its
# tables on start (or run `pnpm db:migrate`), but cannot yet store mandates, so payments
# fail there. Use LEASH_STORAGE=memory for any hosted demo.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leash_db
# LEASH_STORAGE=memory
LEASH_SECRET=super-secret-gateway-signing-key

# PayPal Sandbox Credentials
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
PAYPAL_MERCHANT_ID=your-sandbox-merchant-account-id

# Optional: Gemini key, used only by POST /api/v1/mandates/compile
# GEMINI_API_KEY=your-gemini-api-key

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Next.js Console & Approvals PWA
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Comma-separated origins allowed to call the gateway from a browser (console, approvals PWA)
CORS_ORIGINS=http://localhost:3000
# IANA timezone used for the quiet-hours policy rule (user's local night, not the server's)
LEASH_USER_TIMEZONE=America/Los_Angeles
